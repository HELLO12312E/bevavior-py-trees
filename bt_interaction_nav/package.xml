<?xml version="1.0"?>
<package format="3">
  <name>bt_interaction_nav</name>
  <version>0.0.1</version>
  <description>
    Reactive py_trees behavior tree that approaches person A once (via /cmd_vel),
    waits 10 s, then navigates to goal B using Nav2 NavigateToPose.
  </description>

  <maintainer email="you@example.com">HELLO12312E</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>

  <!-- TODO: replace with the real package that provides the /person message type -->
  <!-- <depend>your_person_msgs</depend> -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
